{
  "$version": 1,
  "type": "energy.ebus.device.lugs",
  "capabilities": {
    "info": {
      "type": "energy.ebus.capability.info",
      "properties": {
        "direction": {
          "name": "Lugs feed direction: upstream or downstream",
          "datatype": "enum",
          "format": "UPSTREAM,DOWNSTREAM"
        }
      }
    },
    "meter": {
      "type": "energy.ebus.capability.meter",
      "properties": {
        "current-a": {
          "literal": "1dp"
        },
        "current-b": {
          "literal": "1dp"
        },
        "active-power": {
          "literal": "1dp"
        },
        "imported-energy": {
          "literal": "1dp"
        },
        "exported-energy": {
          "literal": "1dp"
        }
      }
    }
  }
}
