{
  "$version": 1,
  "type": "energy.ebus.device.lugs",
  "capabilities": {
    "info": {
      "type": "energy.ebus.capability.info",
      "properties": {
        "direction": {
          "name": "Lugs feed direction: upstream or downstream",
          "datatype": "enum",
          "format": "UPSTREAM,DOWNSTREAM"
        }
      }
    },
    "connection": {
      "type": "energy.ebus.capability.connection",
      "properties": {
        "fed-by-device-status": {
          "format": "OK,LOST"
        },
        "feeds-device-status": {
          "format": "OK,LOST"
        }
      }
    }
  }
}
