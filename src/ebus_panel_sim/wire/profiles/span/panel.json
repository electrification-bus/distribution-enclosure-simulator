{
  "$version": 1,
  "type": "energy.ebus.device.distribution-enclosure",
  "capabilities": {
    "status": {
      "type": "energy.ebus.capability.status",
      "properties": {
        "relay": {
          "name": "Main relay",
          "datatype": "enum",
          "format": "UNKNOWN,OPEN,CLOSED"
        },
        "ethernet": {
          "name": "Is Ethernet network interface operational?",
          "datatype": "boolean"
        },
        "wifi": {
          "name": "Is Wi-Fi network interface operational?",
          "datatype": "boolean"
        },
        "wifi-ssid": {
          "name": "SSID to which Wi-Fi network interface is connected",
          "datatype": "string"
        },
        "cloud-connection": {
          "name": "Device connected to vendor cloud?",
          "datatype": "enum",
          "format": "UNKNOWN,UNCONNECTED,CONNECTED"
        },
        "postal-code": {
          "name": "Postal (Zip) code",
          "datatype": "string"
        },
        "time-zone": {
          "name": "Time zone",
          "datatype": "string"
        }
      }
    },
    "shed": {
      "type": "energy.ebus.capability.shed",
      "properties": {
        "policy": {
          "settable": false,
          "format_json": {
            "$id": "soc-priority.v1",
            "type": "object",
            "required": ["algorithm", "parameters"],
            "additionalProperties": false,
            "properties": {
              "algorithm": { "const": "soc-priority.v1" },
              "parameters": {
                "type": "object",
                "required": ["soc-threshold-shed", "soc-threshold-release"],
                "additionalProperties": false,
                "properties": {
                  "soc-threshold-shed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100,
                    "description": "SoC percent below which SOC_THRESHOLD circuits shed"
                  },
                  "soc-threshold-release": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100,
                    "description": "SoC percent above which shed SOC_THRESHOLD circuits restore"
                  }
                }
              }
            }
          }
        }
      }
    },
    "meter": {
      "type": "energy.ebus.capability.meter",
      "properties": {
        "voltage-a": {
          "literal": "1dp"
        },
        "voltage-b": {
          "literal": "1dp"
        }
      }
    },
    "breaker": {
      "type": "energy.ebus.capability.breaker",
      "properties": {
        "rating": {
          "literal": "integer"
        }
      }
    },
    "pcs": {
      "type": "energy.ebus.capability.pcs",
      "properties": {
        "import-limit": {
          "literal": "1dp"
        },
        "feed-import-limit": {
          "literal": "1dp"
        },
        "operator-import-limit": {
          "literal": "1dp"
        },
        "off-grid-import-limit": {
          "literal": "shortest"
        },
        "requested-import-limit": {
          "literal": "1dp"
        }
      }
    },
    "shed-forecast": {
      "type": "energy.ebus.capability.shed-forecast",
      "properties": {
        "total-time-remaining": {
          "literal": "integer"
        },
        "time-to-priority-shed": {
          "literal": "integer"
        },
        "full-charge-total-time-remaining": {
          "literal": "integer"
        },
        "full-charge-time-to-priority-shed": {
          "literal": "integer"
        }
      }
    },
    "power-flows": {
      "type": "energy.ebus.capability.power-flows",
      "properties": {
        "pv": {
          "literal": "integer"
        },
        "battery": {
          "literal": "integer"
        },
        "grid": {
          "literal": "integer"
        },
        "site": {
          "literal": "1dp"
        }
      }
    }
  }
}
